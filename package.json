{
  "name": "pojokpixel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently --kill-others --names API,WEB \"npm:dev:api\" \"npm:dev\"",
    "dev:api": "tsx watch backend/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start:api": "tsx backend/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx backend/migrate.ts",
    "db:seed": "tsx backend/seed.ts",
    "db:test": "tsx backend/db/check.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
