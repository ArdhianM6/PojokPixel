    "@hono/node-server": "^1.19.0",
    "@vitejs/plugin-react": "^5.0.0",
    "better-auth": "^1.7.22",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.9.0",
    "nodemailer": "^10.5.0",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.19.0",
    "typescript": "~5.8.0",
    "vite": "^6.3.0"
  }
